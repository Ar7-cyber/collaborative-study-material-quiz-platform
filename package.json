  "description": "Collaborative Study Material & Quiz Platform - Team 16 Software Engineering Mini Project",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "NODE_ENV=test node --test tests/*.test.js",
